{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/focus/layout,_N_T_/focus/done/layout,_N_T_/focus/done/page,_N_T_/focus/done"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/focus/done/__PAGE__",
    "/focus/done",
    "/focus",
    "/_index",
    "/_head"
  ]
}