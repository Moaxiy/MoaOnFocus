{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/focus/layout,_N_T_/focus/start/layout,_N_T_/focus/start/page,_N_T_/focus/start"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/focus/start/__PAGE__",
    "/focus/start",
    "/focus",
    "/_index",
    "/_head"
  ]
}