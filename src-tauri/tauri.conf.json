{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Today Trajectory",
  "version": "0.1.0",
  "identifier": "com.todaytrajectory.app",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Today Trajectory",
        "width": 1100,
        "height": 760,
        "minWidth": 760,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false
      },
      {
        "label": "focus-pet",
        "url": "pet/",
        "title": "Focus Pet",
        "width": 196,
        "height": 196,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "focusable": false,
        "shadow": false,
        "x": 80,
        "y": 80
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "compression": "lzma"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
